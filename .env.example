# Optional. Set in your shell before pnpm dev / pnpm start.
# The launcher generates an ephemeral API token; do not put credentials in the UI.
# MUSE_BIN=/absolute/path/to/muse
# META_API_KEY=                 # official CLI may use this; API billing applies
# HYBRID_DATA_DIR=/absolute/path/to/private/workspace-data
# PORT=3000
# HYBRID_API_PORT=4310
